load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sonic_data_client",
    srcs = [
        "db_client.go",
        "events_client.go",
        "json_client.go",
        "mixed_db_client.go",
        "non_db_client.go",
        "super_subscription.go",
        "transl_data_client.go",
        "transl_subscriber.go",
        "trie.go",
        "virtual_db.go",
    ],
    cdeps = [
        "@com_github_cesnet_libyang//:libyang",
        "//swsscommon:swsscommon_consolidated_wrapper",
        # Headers and libraries from apt packages (use _wodeps to avoid transitive dep explosion)
        "@@rules_distroless++apt+bookworm_libcrypt-dev-amd64_1-4.4.33-2//:libcrypt_wodeps",
        "@@rules_distroless++apt+bookworm_libboost-thread-dev-amd64_1.74.0.3//:libboost-thread_wodeps",
        "@@rules_distroless++apt+bookworm_libboost-system-dev-amd64_1.74.0.3//:libboost-system_wodeps",
        "@@rules_distroless++apt+bookworm_libpython3.11-dev-amd64_3.11.2-6-deb12u6//:libpython3.11_wodeps",
    ],
    cgo = True,
    # System libraries only - boost/python/zmq/uuid are provided via cdeps
    clinkopts = ["-lpthread", "-ldl", "-lutil", "-Wl,--allow-shlib-undefined"],  #keep
    copts = ["-g -Wall -Iexternal/sonic-swss-common+/common -I/usr/local/include/python3.9 -I/usr/include/python3.9 -Wformat -Werror=format-security -fPIE"],  #keep
    cppopts = [
        "-g",
        "-Wall",
        "-Iexternal/sonic-swss-common+/common",
        # Python 3.11 includes from apt package
        "-isystem",
        "$(GENDIR)/external/rules_distroless++apt+bookworm_libpython3.11-dev-amd64_3.11.2-6-deb12u6/usr/include/python3.11",
        # crypt.h is needed by Python.h
        "-isystem",
        "$(GENDIR)/external/rules_distroless++apt+bookworm_libcrypt-dev-amd64_1-4.4.33-2/usr/include",
        "-Wformat",
        "-Werror=format-security",
        "-fPIE",
    ],  #keep
    importpath = "github.com/sonic-net/sonic-gnmi/sonic_data_client",
    visibility = ["//visibility:public"],
    deps = [
        "//common_utils",
        "//gnmi_server/log",
        "//proto/gnmi_sonic",
        "//sonic_db_config",
        "//sonic_service_client",
        "//swsscommon",
        "//transl_utils",
        "@com_github_c9s_goprocinfo//linux",
        "@com_github_golang_glog//:glog",
        "@com_github_golang_protobuf//proto",
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_openconfig_gnmi//proto/gnmi_ext",
        "@com_github_openconfig_ygot//ygot",
        "@com_github_redis_go_redis_v9//:go-redis",
        "@com_github_workiva_go_datastructures//queue",
        "@in_gopkg_yaml_v2//:yaml_v2",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@sonic-mgmt-common//translib",
        "@sonic-mgmt-common//translib/db",
    ],
)

alias(
    name = "go_default_library",
    actual = ":sonic_data_client",
    visibility = ["//visibility:public"],
)

go_test(
    name = "sonic_data_client_test",
    srcs = [
        "client_test.go",
        "super_subscription_test.go",
    ],
    embed = [":sonic_data_client"],
    # Integration test - requires database_config.json and schema/ directory
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//proto/gnmi_sonic",
        "//swsscommon",
        "//test_utils",
        "@com_github_agiledragon_gomonkey_v2//:gomonkey",
        "@com_github_google_gnxi//utils/xpath",
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_workiva_go_datastructures//queue",
    ],
)
