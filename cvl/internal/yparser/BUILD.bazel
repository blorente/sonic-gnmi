load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "yparser",
    srcs = [
        "ly_path.go",
        "yparser.go",
    ],
    cdeps = [
        "@com_github_cesnet_libyang//:libyang",
    ],
    cgo = True,
