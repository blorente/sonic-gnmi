load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

# TODO(bazel-ready): Fix NewCert() call site,
# expects (tls.Certificate, error) but gets (*bytes.Buffer, *bytes.Buffer, error).
# Pre-existing bug, not caused by Bazel migration.
go_library(
    name = "dialout_server_cli_lib",
    srcs = ["dialout_server_cli.go"],
    importpath = "github.com/sonic-net/sonic-gnmi/dialout/dialout_server_cli",
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = [
        "//dialout/dialout_server",
        "//testdata/tls",
        "@com_github_golang_glog//:glog",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials",
    ],
)

go_binary(
    name = "dialout_server_cli",
    embed = [":dialout_server_cli_lib"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
