{
  "title": "Wildcard OnChange Subscription: /openconfig/interfaces/interface[name=*]/state/hardware-port",
  "globalDef" : {
    "enums" : {
      "hardware-port": {
        "type": "string",
        "pattern": "1/[0-9]+"
      }
    },
    "validators": {
      "state.hwport.1": {
        "type": "object",
        "required": [
          "openconfig-platform-port:hardware-port"
        ],
        "properties": {
          "openconfig-platform-port:hardware-port": {
            "type": "string",
            "const": "1/1"
          }
        }
      },
      "state.hwport.1234": {
        "type": "object",
        "required": [
          "openconfig-platform-port:hardware-port"
        ],
        "properties": {
          "openconfig-platform-port:hardware-port": {
            "type": "string",
            "const": "1/1234"
          }
        }
      }
    }
  },
  "operations":[
    {
      "title": "Subscribes to /interfaces/interface[name=*]/state/hardware-port",
      "operation": "subscribe",
      "operProto": "subscribe:{prefix:{origin:'openconfig'target:'OC_YANG'}encoding:PROTO subscription:{path:{elem:{name:'interfaces'}elem:{name:'interface'key:{key:'name'value:'*'}}elem:{name:'state'}elem:{name:'hardware-port'}}mode:ON_CHANGE}mode:STREAM}",
      "returnCode": 0,
      "subOpers": [
        {
          "oper": "validate",
          "title": "Validates initial updates",
          "timeout": 3000,
          "finalValidator": {
            "xpath": "/interfaces/interface",
            "syncResponse": true,
            "schema": {
              "type": "object",
              "required": ["openconfig-interfaces:interface"],
              "properties": {
                "openconfig-interfaces:interface" : {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "required": ["name", "state"],
                    "properties": {
                      "name": {
                        "type": "string",
                        "enum": [
                          "Ethernet1/1/1", "Ethernet1/1/5", "Ethernet1/2/1", "Ethernet1/2/5", "Ethernet1/3/1", "Ethernet1/4/1", "Ethernet1/4/5", "Ethernet1/5/1", "Ethernet1/5/5", "Ethernet1/6/1", "Ethernet1/7/3", "Ethernet1/7/4", "Ethernet1/8/1", "Ethernet1/8/5", "Ethernet1/9/1", "Ethernet1/9/5", "Ethernet1/9/7", "Ethernet1/11/1", "Ethernet1/11/5"
                        ]
                      },
                      "state": {
                        "type": "object",
                        "properties": {
                          "openconfig-platform-port:hardware-port": {
                            "$ref": "#/globalDef/enums/hardware-port"
                          }
                        }
                      }
                    }
                  },
                  "minItems" : 18,
                  "maxItems" : 18,
                  "additionalItems": false,
                  "contains": {
                    "type": "object",
                    "properties": {
                      "name" : { "type": "string", "const": "Ethernet1/1/1"},
                      "state" : {
                        "type": "object",
                        "required": [ "openconfig-platform-port:hardware-port" ],
                        "properties": {
                          "openconfig-platform-port:hardware-port": {
                            "type": "string", "const": "1/1"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "oper": "dbHSet",
          "title": "Changes Ethernet1/1/1.hardware-port to 1/1234",
          "db": "APPL_STATE_DB",
          "value": {
            "PORT_TABLE:Ethernet1/1/1" : {
              "index": "1234"
            }
          }
        },
        {
          "oper": "validate",
          "title": "Validates update with Ethernet1/1/1.hardware-port 1/1234",
          "timeout": 2000,
          "pathValidators" : [
            {
              "xpath": "/interfaces/interface[name=Ethernet1/1/1]/state/hardware-port",
              "schema": {
                "$ref": "#/globalDef/validators/state.hwport.1234"
              }
            }
          ]
        },
        {
          "oper": "dbHSet",
          "title": "Changes Ethernet1/1/1.hardware-port to 1/1",
          "db": "APPL_STATE_DB",
          "value": {
            "PORT_TABLE:Ethernet1/1/1" : {
              "index": "1"
            }
          }
        },
        {
          "oper": "validate",
          "title": "Validates update with Ethernet1/1/1.hardware-port 1/1",
          "timeout": 2000,
          "pathValidators" : [
            {
              "xpath": "/interfaces/interface[name=Ethernet1/1/1]/state/hardware-port",
              "schema": {
                "$ref": "#/globalDef/validators/state.hwport.1"
              }
            }
          ]
        },
        {
          "oper": "dbHSet",
          "title": "Creates new interface Ethernet1/1234/1",
          "db": "CONFIG_DB",
          "value": {
            "PORT|Ethernet1/1234/1" : {
              "admin-status": "up"
            }
          }
        },
        {
          "oper": "dbHSet",
          "title": "Changes Ethernet1/1/1.hardware-port to 1/1234",
          "db": "APPL_STATE_DB",
          "value": {
            "PORT_TABLE:Ethernet1/1234/1" : {
              "index": "1234"
            }
          }
        },
        {
          "oper": "validate",
          "title": "Validates update with Ethernet1/1234/1.hardware-port 1/1234",
          "timeout": 2000,
          "pathValidators" : [
            {
              "xpath": "/interfaces/interface[name=Ethernet1/1234/1]/state/hardware-port",
              "schema": {
                "$ref": "#/globalDef/validators/state.hwport.1234"
              }
            }
          ]
        },
        {
          "oper": "dbHDel",
          "title": "Delete Ethernet1/1234/1 state",
          "db": "APPL_STATE_DB",
          "value": {
            "PORT_TABLE:Ethernet1/1234/1" : [  ]
          }
        },
        {
          "oper": "validate",
          "title": "Validate delete response for Ethernet1/1234/1/hardware-port",
          "timeout": 2000,
          "pathValidators" : [
            {
              "xpath": "/interfaces/interface[name=Ethernet1/1234/1]/state/hardware-port"
            }
          ]
        },
        {
          "oper": "dbHDel",
          "title": "Delete interface Ethernet1/1234/1",
          "db": "CONFIG_DB",
          "value": {
            "PORT|Ethernet1/1234/1" : []
          }
        }
      ]
    }
  ]
}
