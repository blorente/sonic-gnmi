{
  "title": "Wildcard OnChange Subscription: /openconfig/system/alarm[id=*]/alarm/state/severity",
  "includeDefs": ["../defs/sys_alarm.json"],
  "globalDef": {
    "validators": {
      "severity.major": {
        "type": "object",
        "required": [
          "openconfig-system:severity"
        ],
        "properties": {
          "openconfig-system:severity": {
            "type": "string",
            "const": "openconfig-alarm-types:MAJOR"
          }
        }
      },
      "severity.critical": {
        "type": "object",
        "required": [
          "openconfig-system:severity"
        ],
        "properties": {
          "openconfig-system:severity": {
            "type": "string",
            "const": "openconfig-alarm-types:CRITICAL"
          }
        }
      }
    }
  },
  "operations":[
    {
      "title": "Subscribes to /openconfig/system/alarms/alarm[id=*] with ON_CHANGE",
      "operation": "subscribe",
      "operProto": "subscribe:{prefix:{origin:'openconfig'target:'OC_YANG'}encoding:PROTO subscription:{path:{elem:{name:'system'}elem:{name:'alarms'}elem:{name:'alarm'key:{key:'id'value:'*'}}}mode:ON_CHANGE}mode:STREAM}",
      "returnCode": 0,
      "subOpers": [
        {
          "oper": "validate",
          "title": "Validates initial updates",
          "timeout": 3000,
          "finalValidator": {
            "xpath": "/system/alarms",
            "syncResponse": true,
            "allowDuplicates": false,
            "schema": {
              "type": "object",
              "required": [ "openconfig-system:alarms" ],
              "additionalProperties": false,
              "properties": {
                "openconfig-system:alarms": { "$ref": "#/globalDef/alarmDefs/all_alarms" }
              }
            }
          }
        },
        {
          "oper": "dbHSet",
          "title": "Changes linkqual to active to remove linkqual alarm",
          "db": "STATE_DB",
          "value": {
            "COMPONENT_STATE_TABLE|linkqual:linkqual": {
              "state": "ACTIVE"
            }
          }
        },
        {
          "oper": "validate",
          "title": "Validates onchange delete notification for linkqual",
          "Notes": "validation path is on .../state/severity since that is the DB field changed",
          "timeout": 2000,
          "pathValidators": [
            {
              "xpath": "/system/alarms/alarm[id=linkqual:linkqual_1611693908000099999]/state/severity"
            }
          ]
        },
        {
          "oper": "dbHSet",
          "title": "Restore linkqual to warning",
          "db": "STATE_DB",
          "value": {
            "COMPONENT_STATE_TABLE|linkqual:linkqual": {
              "state": "INACTIVE"
            }
          }
        },
        {
          "oper": "validate",
          "title": "Validates onchange update with linkqual warning",
          "Notes": "validation path is on .../state/severity since that is the DB field changed",
          "timeout": 2000,
          "pathValidators": [
            {
              "xpath": "/system/alarms/alarm[id=linkqual:linkqual_1611693908000099999]/state/severity",
              "schema": { "$ref": "#/globalDef/validators/severity.major" }
            }
          ]
        },
        {
          "oper": "dbHSet",
          "title": "Changes orchagent to inactive to trigger alarm",
          "Notes": "validation path is on .../state/severity since that is the DB field changed",
          "db": "STATE_DB",
          "value": {
            "COMPONENT_STATE_TABLE|swss:orchagent": {
              "state": "INACTIVE"
            }
          }
        },
        {
          "oper": "validate",
          "title": "Validates onchange update with orchagent critical",
          "timeout": 2000,
          "pathValidators": [
            {
              "xpath": "/system/alarms/alarm[id=swss:orchagent_1611693908000007777]/state/severity",
              "schema": { "$ref": "#/globalDef/validators/severity.critical" }
            }
          ]
        },
        {
          "oper": "dbHSet",
          "title": "Restore orchagent to active",
          "db": "STATE_DB",
          "value": {
            "COMPONENT_STATE_TABLE|swss:orchagent": {
              "state": "ACTIVE"
            }
          }
        },
        {
          "oper": "validate",
          "title": "Validates onchange delete update with orchagent",
          "timeout": 2000,
          "pathValidators": [
            {
              "xpath": "/system/alarms/alarm[id=swss:orchagent_1611693908000007777]/state/severity"
            }
          ]
        },
        {
          "oper": "dbHSet",
          "title": "Create new alarmtest01234 alarm",
          "db": "STATE_DB",
          "value": {
            "COMPONENT_STATE_TABLE|alarmtest01234": {
              "state": "INACTIVE",
              "timestamp-seconds": "1611693908",
              "timestamp-nanoseconds": "11111"
            }
          }
        },
        {
          "oper": "validate",
          "title": "Validates onchange update with alarmtest01234 warning",
          "timeout": 2000,
          "pathValidators": [
            {
              "xpath": "/system/alarms/alarm[id=alarmtest01234_1611693908000011111]/id",
              "schema": {
                "type": "object",
                "required": ["openconfig-system:id"],
                "additionalProperties": false,
                "properties": {
                  "openconfig-system:id": { "type": "string", "const": "alarmtest01234_1611693908000011111" }
                }
              }
            },
            {
              "xpath": "/system/alarms/alarm[id=alarmtest01234_1611693908000011111]/state/id",
              "schema": {
                "type": "object",
                "required": ["openconfig-system:id"],
                "additionalProperties": false,
                "properties": {
                  "openconfig-system:id": { "type": "string", "const": "alarmtest01234_1611693908000011111" }
                }
              }
            },
            {
              "xpath": "/system/alarms/alarm[id=alarmtest01234_1611693908000011111]/state/resource",
              "schema": {
                "type": "object",
                "required": ["openconfig-system:resource"],
                "additionalProperties": false,
                "properties": {
                  "openconfig-system:resource": { "type": "string", "const": "alarmtest01234" }
                }
              }
            },
            {
              "xpath": "/system/alarms/alarm[id=alarmtest01234_1611693908000011111]/state/severity",
              "schema": {
                "type": "object",
                "required": ["openconfig-system:severity"],
                "additionalProperties": false,
                "properties": {
                  "openconfig-system:severity": { "$ref": "#/globalDef/alarmDefs/severity_major" }
                }
              }
            },
            {
              "xpath": "/system/alarms/alarm[id=alarmtest01234_1611693908000011111]/state/text",
              "schema": {
                "type": "object",
                "required": ["openconfig-system:text"],
                "additionalProperties": false,
                "properties": {
                  "openconfig-system:text": { "type": "string", "const": "INACTIVE: " }
                }
              }
            },
            {
              "xpath": "/system/alarms/alarm[id=alarmtest01234_1611693908000011111]/state/time-created",
              "schema": {
                "type": "object",
                "required": ["openconfig-system:time-created"],
                "additionalProperties": false,
                "properties": {
                  "openconfig-system:time-created": { "type": "string", "const": "1611693908000011111" }
                }
              }
            },
            {
              "xpath": "/system/alarms/alarm[id=alarmtest01234_1611693908000011111]/state/type-id",
              "schema": {
                "type": "object",
                "required": ["openconfig-system:type-id"],
                "additionalProperties": false,
                "properties": {
                  "openconfig-system:type-id": { "$ref": "#/globalDef/alarmDefs/type_sw" }
                }
              }
            }
          ]
        },
        {
          "oper": "dbHDel",
          "title": "Deletes alarmtest01234",
          "db": "STATE_DB",
          "value": {
            "COMPONENT_STATE_TABLE|alarmtest01234": []
          }
        },
        {
          "oper": "validate",
          "title": "Validates delete update for alarmtest01234",
          "timeout": 2000,
          "pathValidators": [
            {
              "xpath": "/system/alarms/alarm[id=alarmtest01234_1611693908000011111]"
            }
          ]
        }
      ]
    }
  ]
}
