{
  "title": "ONCE Subscribe with interfaces with wildcard",
  "operations":[
    {
      "title": "subscribe (ONCE) to /interfaces/interface[name=*]/{state|config}",
      "operation": "subscribe",
      "operProto": "subscribe:{prefix:{origin:'openconfig'target:'OC_YANG'}subscription:{path:{elem:{name:'interfaces'}elem:{name:'interface'key:{key:'name'value:'*'}}elem:{name:'state'}}}subscription:{path:{elem:{name:'interfaces'}elem:{name:'interface'key:{key:'name'value:'*'}}elem:{name:'config'}}}encoding:PROTO mode:ONCE}",
      "returnCode": 0,

      "subOpers": [
        {
          "oper": "validate",
          "title": "Validates initial updates",
          "timeout": 3000,
          "allowDuplicateUpdates": false,
          "finalValidator": {
            "xpath": "/",
            "syncResponse": true,
            "schema": {
              "type": "object",
              "required": ["openconfig-interfaces:interfaces"],
              "properties": {
                "openconfig-interfaces:interfaces": {
                  "type": "object",
                  "required": ["interface"],
                  "properties": {
                    "interface": {
                      "type": "array",
                      "uniqueItems": true,
                      "minItems" : 25,
                      "maxItems" : 25,
                      "additionalItems": false
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  ]
}
