{
  "title": "Get Interface counters",
  "operations":[
    {
      "operation": "get",
      "returnCode": 0,
      "xpath": "openconfig/interfaces/interface[name=Ethernet1/1/1]",
      "target": "OC_YANG",
      "type": "object",
      "required": [
        "openconfig-interfaces:interface"
      ],
      "properties": {
        "openconfig-if-ethernet:ethernet": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["state"],
            "properties": {
              "state": {
                "type": "object",
                  "required": ["counters"],
            "properties": {
              "counters": {
                "type": "object",
                  "required": ["in-maxsize-exceeded"],
                  "properties": {
                    "counters": {
                     "type": "string",
                     "enum": ["1000"]
                    }
                  }
                 }
               }
              }
            }
          }
        }
      }
    }
  ]
}
