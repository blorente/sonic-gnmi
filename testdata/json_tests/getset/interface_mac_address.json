{
  "title": "Get interface mac-address",
  "operations":[
    {
      "operation": "get",
      "returnCode": 0,
      "xpath": "openconfig/interfaces/interface[name=Ethernet1/1/1]",
      "target": "OC_YANG",
      "type": "object",
      "required": [
        "openconfig-interfaces:interface"
      ],
      "properties": {
        "openconfig-if-ethernet:ethernet": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "type": "object",
                "required": [
                  "mac-address"
                ],
                "properties": {
                  "mac-address": {
                    "type": "string",
                    "enum": [
                      "01:02:03:04:05:06"
                    ],
                    "pattern": "^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$"
                  }
                }
              }
            }
          }
        }
      }
    },
