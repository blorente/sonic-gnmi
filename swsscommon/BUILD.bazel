load("@io_bazel_rules_go//go:def.bzl", "go_library")

#gazelle:exclude empty.go

genrule(
    name = "swsscommon-gen",
    srcs = [
        "@sonic-swss-common//:swig_template",
        "@sonic-swss-common//:all_hdrs",
    ],
    outs = [
        "swsscommon.go",
        "swsscommon_wrap.cxx",
        "swsscommon_wrap.h",
    ],
    cmd = """
          mkdir -p gen_tmp
          cp $(location @sonic-swss-common//:swig_template) ./gen_tmp
          cp $(locations @sonic-swss-common//:all_hdrs) ./gen_tmp
          pushd gen_tmp
          swig -go -cgo -c++ -intgosize 64 -I. swsscommon.i
          # Swig is generating C++ code that does not compile.  A const string
          # (const char*) is being assigned to a non const char *.  The
          # following two sed statements workaround that for now.
          sed -i -e 's/char \\*result =/const char \\*result =/g' swsscommon_wrap.cxx
          sed -i -e 's/(char\\*)result/result/g' swsscommon_wrap.cxx
          popd
          for i in $(OUTS); do
              fpath=`dirname $${i}`
              fname=`basename $${i}`
              cp ./gen_tmp/$${fname} $${fpath}
          done
          """,
)

go_library(
    name = "swsscommon",
    srcs = [
        "swsscommon.go",
        "swsscommon_wrap.cxx",  #keep
        "swsscommon_wrap.h",
    ] + ["@sonic-swss-common//:all_hdrs"],
    cdeps = [":swsscommon_consolidated_wrapper"],
    cgo = True,  #keep
    clinkopts = ["-fuse-ld=bfd"],
    cppopts = [
        "-I.",
        "-Iexternal/sonic-swss-common+/common",
        "-I$(GENDIR)/external/sonic-swss-common/common",
    ],
    importpath = "github.com/sonic-net/sonic-gnmi/swsscommon",
    visibility = ["//visibility:public"],
)

# Wrapper cc_library that references the consolidated shared library
# The consolidated .so already contains everything needed (libbsd, libmd statically linked)
# We only need the headers and the .so itself - no deps on @bookworm// packages
# This prevents CGO from trying to link transitive .so files that aren't in the sandbox
# We use linkopts to specify the runtime dependencies instead of deps to avoid the transitive dependency issue
cc_library(
    name = "swsscommon_consolidated_wrapper",
    srcs = ["@sonic-swss-common//:libswsscommon_consolidated.so"],
    hdrs = ["@sonic-swss-common//:all_hdrs"],
    linkopts = [
        "-lhiredis",
        "-lnl-3",
        "-lnl-route-3",
        "-lnl-nf-3",
        "-lzmq",
        "-luuid",
        "-lboost_serialization",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "swsscommon_go_cpp",
    srcs = [
        "swsscommon_wrap.cxx",
    ],
    hdrs = ["swsscommon_wrap.h"],
    copts = [
        "-I$(GENDIR)/external/sonic-swss-common/common",
        "-Iexternal/sonic-swss-common/common",
    ],
    implementation_deps = [
        "@sonic-swss-common//:swsscommon_base",
    ],
)

alias(
    name = "go_default_library",
    actual = ":swsscommon",
    visibility = ["//visibility:public"],
)
