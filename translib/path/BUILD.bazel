load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "path",
    srcs = [
        "path.go",
        "path_validator.go",
    ],
    importpath = "github.com/Azure/sonic-mgmt-common/translib/path",
    visibility = ["//visibility:public"],
    deps = [
        "//translib/log",
        "//translib/ocbinds",
        "//translib/tlerr",
        "@com_github_golang_glog//:glog",
        "@com_github_kylelemons_godebug//pretty",
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_openconfig_goyang//pkg/yang",
        "@com_github_openconfig_ygot//util",
        "@com_github_openconfig_ygot//ygot",
        "@com_github_openconfig_ygot//ytypes",
    ],
)

go_test(
    name = "path_test",
    srcs = [
        "path_test.go",
        "path_validator_test.go",
    ],
    embed = [":path"],
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_openconfig_ygot//ygot",
    ],
)

alias(
    name = "go_default_library",
    actual = ":path",
    visibility = ["//visibility:public"],
)
