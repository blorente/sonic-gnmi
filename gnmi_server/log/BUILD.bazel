load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "log",
    srcs = ["level.go"],
    importpath = "github.com/sonic-net/sonic-gnmi/gnmi_server/log",
    visibility = ["//visibility:public"],
    deps = ["@com_github_golang_glog//:glog"],
)

go_test(
    name = "log_test",
    srcs = [
        "glog_test.go",
        "level_test.go",
    ],
    embed = [":log"],
    deps = ["@com_github_golang_glog//:glog"],
)

go_test(
    name = "glog_test",
    srcs = ["glog_test.go"],
    deps = ["@com_github_golang_glog//:go_default_library"],
)

alias(
    name = "go_default_library",
    actual = ":log",
    visibility = ["//visibility:public"],
)
