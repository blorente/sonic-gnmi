container_image(
    name = "gnmi_server_test_image",
    testonly = 1,
    base = "@test_image//image",
    entrypoint = ["/entrypoint-test.sh"],
    env = {
        # Two environment variables which allow libyang to find its plugins
        "LIBYANG_EXTENSIONS_PLUGINS_DIR": "/extensions/",
        "LIBYANG_USER_TYPES_PLUGINS_DIR": "/user_types/",
        "CVL_SCHEMA_PATH": "/usr/sbin/schema",
        "CVL_CFG_FILE": "/usr/sbin/cvl_cfg.json",
        "DB_CONFIG_PATH": "/testdata/database_config.json",
        "YANG_MODELS_PATH": "/usr/models/yang",
    },
    files = [
        ":gnmi_server_test",
        "//common_utils",
        "//common_utils:common_utils_test",
        "//dialout/dialout_client:dialout_client_test",
        "//gnmi_server/pathtransl:pathtransl_test",
        "//gnoi_client",
        "//metric_recorder:metric_recorder_test",
        "//pathz_authorizer:pathz_authorizer_test",
        "//sonic_data_client:sonic_data_client_test",
        "//sonic_db_config:sonic_db_config_test",
        "//telemetry",
        "//third_party:gnmi_get",
        "//third_party:gnmi_set",
        "//tools/docker:entrypoint-test.sh",
        "//tools/test/docker:redis_load.py",
        "//transl_utils:transl_utils_test",
        "//translib:translib_test",
        "//translib/cs:cs_test",
        "//translib/db:db_test",
        "//translib/log:log_test",
        "//translib/ocbinds:ocbinds_test",
        "//translib/path:path_test",
        "//translib/platform:platform_test",
        "//translib/tlerr:tlerr_test",
        "//translib/transformer:transformer_test",
        "@com_github_cesnet_libyang//:libyang",
        "@pcre_archive//:pcre_shared",
        "@sonic-swss-common//:all_luas",
    ],
    symlinks = {
        # Links to "install" libyang
        "/lib/x86_64-linux-gnu/libyang.so": "/libyang.so",
        "/lib/x86_64-linux-gnu/libyang.so.1": "/libyang.so.1",
        "/lib/x86_64-linux-gnu/libyang.so.1.10.17": "/libyang.so.1.10.17",
        # PCRE is a dependency of libyang
        "/lib/x86_64-linux-gnu/libpcre.so": "/libpcre.so",
        "/lib/x86_64-linux-gnu/libpcrecpp.so": "/libpcrecpp.so",
        "/lib/x86_64-linux-gnu/libpcreposix.so": "/libpcreposix.so",

        # Include the sonic-swss-common scripts
        "/usr/share/swss/consumer_state_table_pops.lua": "/consumer_state_table_pops.lua",
        "/usr/share/swss/consumer_table_pops.lua": "/consumer_table_pops.lua",
        "/usr/share/swss/fdb_flush.lua": "/fdb_flush.lua",
        "/usr/share/swss/fdb_flush.v2.lua": "/fdb_flush.v2.lua",
        "/usr/share/swss/portcounter.lua": "/portcounter.lua",
        "/usr/share/swss/producer_state_table_apply_view.lua": "/producer_state_table_apply_view.lua",
        "/usr/share/swss/table_dump.lua": "/table_dump.lua",
        "/var/run/redis/sonic-db/database_config.json": "/testdata/database_config.json",
        "/usr/share/sonic/hwsku/qos_queue_map.json": "/testdata/qos_queue_map.json",
        "/usr/share/sonic/hwsku/platform.json": "/testdata/platform.json",
        "/etc/ntp.conf": "/testdata/ntp.conf",
        "/workspace/testdata": "/testdata",
        "/workspace/build/bin/gnoi_client": "/gnoi_client",
        "/workspace/build/bin/gnmi_get": "/gnmi_get",
        "/workspace/build/bin/gnmi_set": "/gnmi_set",
    },
    tars = [
        "//test:py_tests_tar",
        "//testdata:testdata_tar",
        "//testdata/json_tests/json-testsuite-gen:gentests_tar",
        "//cvl:cvl_tar",
        "//models/yang:models_tar",
        "//models/yang:models_test_tar",
    ],
    visibility = ["//visibility:public"],
)

