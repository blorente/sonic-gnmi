load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@gazelle//:def.bzl", "gazelle")

# gazelle:prefix github.com/sonic-net/sonic-gnmi
# gazelle:exclude patches
# gazelle:go_naming_convention import_alias

### Help Gazelle resolve directories from Mgmt-Common
# gazelle:resolve go github.com/Azure/sonic-mgmt-common/cvl/custom_validation @sonic-mgmt-common//cvl/custom_validation
# gazelle:resolve go github.com/Azure/sonic-mgmt-common/translib @sonic-mgmt-common//translib
# gazelle:resolve go github.com/Azure/sonic-mgmt-common/translib/db @sonic-mgmt-common//translib/db
# gazelle:resolve go github.com/Azure/sonic-mgmt-common/translib/ocbinds @sonic-mgmt-common//translib/ocbinds
# gazelle:resolve go github.com/Azure/sonic-mgmt-common/translib/path @sonic-mgmt-common//translib/path
# gazelle:resolve go github.com/Azure/sonic-mgmt-common/translib/tlerr @sonic-mgmt-common//translib/tlerr
# gazelle:resolve go github.com/Azure/sonic-mgmt-common/translib/transformer @sonic-mgmt-common//translib/transformer

### Help Gazelle resolve openconfig/gnmi Go imports to our patched repo, not the BCR module
### we need for gnsi.
#
# gazelle:resolve go github.com/openconfig/gnmi/client @com_github_openconfig_gnmi//client
# gazelle:resolve go github.com/openconfig/gnmi/client/gnmi @com_github_openconfig_gnmi//client/gnmi
# gazelle:resolve go github.com/openconfig/gnmi/errlist @com_github_openconfig_gnmi//errlist
# gazelle:resolve go github.com/openconfig/gnmi/path @com_github_openconfig_gnmi//path
# gazelle:resolve go github.com/openconfig/gnmi/proto/gnmi @com_github_openconfig_gnmi//proto/gnmi
# gazelle:resolve go github.com/openconfig/gnmi/proto/gnmi_ext @com_github_openconfig_gnmi//proto/gnmi_ext
# gazelle:resolve go github.com/openconfig/gnmi/value @com_github_openconfig_gnmi//value

### Help Gazelle resolve external proto files
# gazelle:resolve go          google.golang.org/genproto/googleapis/rpc/status @org_golang_google_genproto_googleapis_rpc//status
# gazelle:resolve proto go    google/rpc/status.proto                          @org_golang_google_genproto_googleapis_rpc//status
# gazelle:resolve proto proto google/rpc/status.proto                          @googleapis//google/rpc:status_proto
# gazelle:resolve proto go    github.com/openconfig/gnoi/types/types.proto     @com_github_openconfig_gnoi//types
# gazelle:resolve proto proto github.com/openconfig/gnoi/types/types.proto     @com_github_openconfig_gnoi//types:types_proto
# gazelle:resolve proto go    github.com/openconfig/ygot/proto/yext/yext.proto @com_github_openconfig_ygot//proto/yext:yext_go_proto
# gazelle:resolve proto proto github.com/openconfig/ygot/proto/yext/yext.proto @com_github_openconfig_ygot//proto/yext:yext_proto
# gazelle:resolve proto go    github.com/openconfig/gnmi/proto/gnmi/gnmi.proto @com_github_openconfig_gnmi//proto/gnmi
# gazelle:resolve proto proto github.com/openconfig/gnmi/proto/gnmi/gnmi.proto @com_github_openconfig_gnmi//proto/gnmi:gnmi_proto
# gazelle:resolve proto go    github.com/gogo/protobuf/gogoproto/gogo.proto    @com_github_gogo_protobuf//gogoproto

