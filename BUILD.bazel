buildifier(
    name = "buildifier",
    exclude_patterns = [
        "./.git/*",
    ],
    lint_mode = "warn",
)

# Use this to generate a text file with a tree diagram of all YANG models
# used by UMF.
alias(
    name = "whole-yang-tree-txt",
    actual = "@sonic-mgmt-common//models/yang:yang-tree",
)

