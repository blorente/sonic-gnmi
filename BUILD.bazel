# Use this to generate a text file with a tree diagram of all YANG models
# used by UMF.
alias(
    name = "whole-yang-tree-txt",
    actual = "//models/yang:whole-tree",
)

# A shortcut to build a Docker image that is used for component testing.
alias(
    name = "gnmi_server_test_image",
    actual = "//gnmi_server:gnmi_server_test_image",
)

# A shortcut to build a Docker image that is used for debugging UMF.
alias(
    name = "gnmi_server_debug_image",
    actual = "//gnmi_server:gnmi_server_debug_image",
)

# Alias for hermetic PAM library (used by external repositories)
alias(
    name = "third_party_pam",
    actual = "//third_party/pam:pam",
    visibility = ["//visibility:public"],
)
