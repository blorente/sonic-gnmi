load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test", "nogo")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//:pkg.bzl", "pkg_deb", "pkg_tar")

#gazelle:ignore */telemetry_test.go

go_test(
    name = "telemetry_test",
    srcs = ["telemetry_test.go"],
    embed = [":telemetry_lib"],
    # Tests reference startGNMIServer which is commented out in telemetry.go
    # The production code uses startGNMIServerGoog instead
    # TODO: Update tests to work with startGNMIServerGoog or uncomment startGNMIServer
    tags = ["manual"],
    deps = [
        "//gnmi_server",
        "//test_utils",
        "//testdata/tls",
        "@com_github_agiledragon_gomonkey_v2//:gomonkey",
        "@com_github_fsnotify_fsnotify//:fsnotify",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials",
    ],
)

