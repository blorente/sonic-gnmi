go_library(
    name = "telemetry_lib",
    srcs = ["telemetry.go"],
    importpath = "github.com/sonic-net/sonic-gnmi/telemetry",
    visibility = ["//visibility:private"],
    deps = [
        "//common_utils",
        "//gnmi_server",
        "//gnmi_server/log",
        "//swsscommon",
        "@com_github_golang_glog//:glog",
        "@sonic-mgmt-common//translib/db",
    ],
)

go_binary(
    name = "telemetry",
    cdeps = [
        "@com_github_cesnet_libyang//:libyang",
    ],
    cgo = True,  #keep
    clinkopts = [
        "-static-libstdc++",
        "-static-libgcc",
    ],
    embed = [":telemetry_lib"],
    visibility = ["//visibility:public"],
)

# Tar layers for telemetry OCI image
# Each tar becomes a separate layer - order matters for caching efficiency
pkg_tar(
    name = "telemetry_files_layer",
    srcs = [
        ":telemetry",
        "//tools/docker:entrypoint-prod.sh",
        "//tools/docker:supervisord.conf",
        "//tools/docker:telemetry.sh",
        "//tools/docker:database_config.json",
        "@sonic-buildimage//:dockers/docker-base-bullseye/etc/rsyslog.conf",
        "@sonic-buildimage//:dockers/docker-base-bullseye/etc/rsyslog.d/supervisor.conf",
        "@sonic-buildimage//:dockers/docker-sonic-gnmi/critical_processes",
        "@sonic-buildimage//:src/sonic-supervisord-utilities/scripts/supervisor-proc-exit-listener",
        "@sonic-buildimage//:dockers/docker-sonic-gnmi/start.sh",
        "@sonic-buildimage//:dockers/docker-sonic-gnmi/telemetry_vars.j2",
    ],
    mode = "0755",
)

# Symlinks layer for telemetry image
pkg_tar(
    name = "telemetry_symlinks_layer",
    symlinks = {
        "/usr/share/sonic/hwsku/qos_queue_map.json": "/testdata/qos_queue_map.json",
        "/usr/share/sonic/hwsku/platform.json": "/testdata/platform.json",
        "/etc/ntp.conf": "/testdata/ntp.conf",
    },
)

oci_image(
    name = "telemetry_image",
    base = "@telemetry_image",
    entrypoint = ["/entrypoint-prod.sh"],
    tars = [
        "//testdata:testdata_tar",
        "@sonic-buildimage//:sonic-cfggen.tar",
        "@sonic-mgmt-common//cvl:cvl_tar",
        "@sonic-mgmt-common//models/yang:models_tar",
        ":telemetry_files_layer",
        ":telemetry_symlinks_layer",
    ],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "telemetry_bundle",
    image = ":telemetry_image",
    repo_tags = ["bazel/telemetry_image:latest"],
)

# Host image layers
pkg_tar(
    name = "host_files_layer",
    srcs = [
        "//tools/docker:entrypoint-host.sh",
        "//tools/docker:rsyslog.host",
    ],
    mode = "0755",
)

pkg_tar(
    name = "host_symlinks_layer",
    symlinks = {
        "/etc/ntp.conf": "/testdata/ntp.conf",
    },
)

oci_image(
    name = "host_image",
    base = "@host_image",
    entrypoint = ["/entrypoint-host.sh"],
    tars = [
        "//testdata:testdata_tar",
        ":host_files_layer",
        ":host_symlinks_layer",
    ],
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "telemetry-bin",
    srcs = [
        ":telemetry",
        #TODO Add these packages to deb
        #":dialout_client_cli",
        #":gnmi_cli",
        #":gnmi_get",
        #":gnmi_set",
        #":gnoi_client",
        #":grpc_cli",
    ],
    mode = "0755",
    package_dir = "/usr/sbin",
    strip_prefix = ".",
    visibility = ["//visibility:public"],
)

#bazel build :telemetry_deb_pkg
#bazel cquery --output=files :telemetry_deb_pkg
pkg_deb(
    name = "telemetry_deb_pkg",
    architecture = "amd64",
    built_using = "bazel",
    data = "//telemetry:telemetry-bin",
    depends = [
        "libc6",  #(>= 2.25)
        "libgcc1",  #(>= 1:3.0)
        "libpam0g",  #(>= 0.99.7.1)
        "libstdc++6",  #(>= 6)
        "libsystemd0",  #(>= 233)
        "libyang",
    ],
    description = "Sonic gNMI",
    maintainer = "GPINS gNMI Team (Google)",
    package = "sonic-telemetry",

    # Currently uses static naming
    package_file_name = "sonic-telemetry_0.1_amd64.deb",
    version = "0.1",
)
