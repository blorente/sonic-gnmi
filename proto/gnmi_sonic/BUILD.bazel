load("@rules_proto//proto:defs.bzl", "proto_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@io_bazel_rules_go//go:def.bzl", "go_library")

#gazelle:ignore

go_library(
    name = "gnmi_sonic",
    srcs = [
        "constants.go",
        "dial_out.pb.go",
        "sonic.pb.go",
        "sonic_internal.pb.go",
        "umf_debug_info.pb.go",
    ],
    #embed = [":gnmi_sonic_go_proto"],
    importpath = "github.com/sonic-net/sonic-gnmi/proto/gnmi_sonic",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_golang_protobuf//proto:go_default_library",
        "@com_github_golang_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb:timestamppb",
        "@org_golang_x_net//context",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//runtime/protoimpl",
        "@org_golang_google_grpc//:grpc"
    ],
)

alias(
    name = "go_default_library",
    actual = ":gnmi_sonic",
    visibility = ["//visibility:public"],
)

proto_library(
    name = "gnmi_sonic_proto",
    srcs = [
        "dial_out.proto",
        "sonic.proto",
        "sonic_internal.proto",
        "umf_debug_info.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_openconfig_gnmi//proto/gnmi:gnmi_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
)

go_proto_library(
    name = "gnmi_sonic_go_proto",
    compilers = ["@io_bazel_rules_go//proto:go_grpc"],
    proto = ":gnmi_sonic_proto",
    deps = [
        "@com_github_openconfig_gnmi//proto/gnmi",
    ],
)
