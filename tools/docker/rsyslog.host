#@version: 8.2008.0
# default /etc/rsyslogd.conf for externally facing roles
# autogenerated by /etc/bashup.d/syslog.mkconf - do not edit
#
# This version has all external logging enabled.
# Items that need to be modified for each specific cluster are:
#   destination d_sc_network
#
# rsyslog declares this a misfeature, so it's not implemented in "new" syntax

$RepeatedMsgReduction on
module(load="imudp")
# Output stats periodically
module(load="impstats" Interval="86400")
# Rate limit to 30/second/process, measured over a minute timescale
# imuxsock creates /dev/log by default
module(load="imuxsock"
       SysSock.Use="on"
       SysSock.Unlink="on"
       SysSock.UseSpecialParser="on"
       SysSock.RateLimit.Interval="60"
       SysSock.RateLimit.Burst="1800")
# module(load="imklog")
template(name="file_log_template" type="list") {
     property(name="timereported" dateFormat="rfc3339")
     constant(value=" ")
     property(name="hostname")
     constant(value=" ")
     property(name="syslogfacility-text")
     constant(value=".")
     property(name="syslogseverity-text")
     constant(value=" ")
     property(name="syslogtag")
     property(name="msg" spifno1stsp="on")
     property(name="msg" droplastlf="on")
     constant(value="\n")
}
$outchannel sc_flash,/var/log/sandcastle.log,4194304
$outchannel sc_temp,/var/log/tmp/sandcastle.log,4194304
$outchannel sys_flash,/var/log/messages,4194304
$outchannel sys_temp,/var/log/tmp/messages,4194304
$outchannel rymden_flash,/var/log/rymden_supervisor.log,1048576
$outchannel high_prio,/var/log/high_prio.log,1048576
$outchannel low_prio,/var/log/low_prio.log,1048576
# Directly written to from input
ruleset(name="rymden_output") {
  *.* :omfile:$rymden_flash;file_log_template
}
ruleset(name="output_network_high_priority") {
  *.* :omfile:$high_prio;file_log_template
#  *.* action(type="omfwd" Target="2001:4860:f802::c0" Port="9520" queue.type="LinkedList" queue.size="3000" queue.timeoutEnqueue="0" action.resumeInterval="60" action.resumeRetryCount="5" action.reportSuspension="on" action.reportSuspensionContinuation="on")
#  *.* action(type="omfwd" Target="2001:4860:f802::bf" Port="9520" queue.type="LinkedList" queue.size="3000" queue.timeoutEnqueue="0" action.resumeInterval="60" action.resumeRetryCount="5" action.reportSuspension="on" action.reportSuspensionContinuation="on")
}
ruleset(name="output_network_low_priority") {
  *.* :omfile:$low_prio;file_log_template
#  *.* action(type="omfwd" Target="2001:4860:f802::c0" Port="9524" queue.type="LinkedList" queue.size="3000" queue.timeoutEnqueue="0" action.resumeInterval="60" action.resumeRetryCount="5" action.reportSuspension="on" action.reportSuspensionContinuation="on")
#  *.* action(type="omfwd" Target="2001:4860:f802::bf" Port="9524" queue.type="LinkedList" queue.size="3000" queue.timeoutEnqueue="0" action.resumeInterval="60" action.resumeRetryCount="5" action.reportSuspension="on" action.reportSuspensionContinuation="on")
}
# Drop it if it's a CRON job log corresponding to logrotate
if ($syslogfacility-text == 'cron') then {
  :msg, contains, "cmd [ -f /etc/logrotate.conf ] && /bin/nice -n 1 /usr/sbin/logrotate -s /var/run/logrotate.state /etc/logrotate.conf >/dev/null 2>&1"  ~
}
# Send messages from containers (on local machine) to log.
ruleset(name="container_log_output") {
  if (($fromhost-ip=='127.0.0.1')) then {
    # All messages go to low-priority network and temporary RAM
    :omfile:$sc_temp;file_log_template
    call output_network_low_priority
    # Drop it if it's lower priority than notice
    if ($syslogseverity > 5) then stop
    # Higher priority goes to flash
    :omfile:$sc_flash;file_log_template
    # Drop it if it's lower priority than error
    if ($syslogseverity > 3) then stop
    # Send to high priority network
    call output_network_high_priority
  }
  stop
}
if (($syslogfacility-text == 'local6') or ($syslogfacility-text == 'user')) then {
  # all messages in this category go to network and RAM
  call output_network_low_priority
  :omfile:$sc_temp;file_log_template
  # Drop it if it's user (stack) and lower priority than notice
  if (($syslogfacility-text == 'user') and ($syslogseverity > 5)) then stop
  # Higher priority messages go to flash and previous locations
  :omfile:$sc_flash;file_log_template
  # Drop it if it's user (stack) and lower priority than error
  if (($syslogfacility-text == 'user') and ($syslogseverity > 3)) then stop
  # Highest priority messages go to network
  call output_network_high_priority
  stop
}
# all messages in this category go to RAM
*.* :omfile:$sys_temp;file_log_template
# Drop dhcpd and dhclient messages with priority less than notice
if ((($programname == 'dhcpd') or ($programname == 'dhclient')) and ($syslogseverity > 5)) then {
  stop
}
# all messages in this category go to network
*.* call output_network_low_priority
if (($syslogfacility-text == 'auth') or ($syslogfacility-text == 'authpriv')) then {
  :omfile:$sys_flash;file_log_template
  call output_network_high_priority
  stop
}
# Drop everything less than notice
if ($syslogseverity > 5) then stop
:omfile:$sys_flash;file_log_template
# imklog module load implicitly starts klog
# udp port 9520 used to receive all log messages from linecards.
# We're keeping it around for the moment until we're sure it's not used.
input(type="imudp"
      port="9520")
# Use port 514 for container logging.
# Rate-limiting is set to 10000 messages per 5 minutes.
input(type="imudp"
      port="514"
      ratelimit.interval="300"
      ratelimit.burst="10000"
      ruleset="container_log_output")
input(type="imuxsock"
      socket="/dev/rymden_log"
      Unlink="off"
      Ruleset="rymden_output")
