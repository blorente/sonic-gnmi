# msteinert/pam (with custom BUILD to link PAM library)
http_archive(
    name = "com_github_msteinert_pam",
    build_file = "//third_party/pam:BUILD.bazel",
    sha256 = "7533c93ad659e16c3abd8b2cf807a61b035fd282f1c10a039bcd1aad837f4228",
    strip_prefix = "pam-1.2.0",
