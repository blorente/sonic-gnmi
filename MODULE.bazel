module(
    name = "sonic-gnmi",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1")
bazel_dep(name = "rules_proto_grpc", version = "5.0.0")
bazel_dep(name = "rules_proto_grpc_cpp", version = "5.0.0")
bazel_dep(name = "rules_java", version = "8.14.0")
bazel_dep(name = "googleapis", version = "0.0.0-20251104-53af3b72")
bazel_dep(name = "grpc", version = "1.56.3.bcr.1", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "protobuf", version = "23.1", repo_name = "com_google_protobuf")
bazel_dep(name = "gazelle", version = "0.46.0")
bazel_dep(name = "rules_distroless", version = "0.0.0")
git_override(
    module_name = "rules_distroless",
    commit = "ebfd74a2e07b83235e064bb63ace98a1a5223e02",
    remote = "https://github.com/bazel-contrib/rules_distroless",
)

# SONiC dependencies (resolved through sonic-buildimage's repository)
bazel_dep(name = "sonic-build-infra", version = "0.0.0")
bazel_dep(name = "sonic-swss-common", version = "0.0.0")
bazel_dep(name = "sonic-mgmt-common", version = "1.0.0")
bazel_dep(name = "libyang", version = "1.0.73", repo_name = "com_github_cesnet_libyang")
bazel_dep(name = "rules_go", version = "0.60.0.sonic-patched", repo_name = "io_bazel_rules_go") # Resolves from the local Bazel repository at @sonic-buildimage/tools/bazel/repository

register_toolchains("@sonic-build-infra//toolchains/gcc:host_gcc_toolchain")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.11",
)

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = [
        "bookworm",
        "bookworm-updates",
    ],
    uris = ["https://snapshot.debian.org/archive/debian/20251001T023456Z"],
)
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["bookworm-security"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20251001T023456Z"],
)
apt.install(
    dependency_set = "bookworm",
    packages = [
        "libpcre3",
        "libpcre3-dev",
        "libbsd-dev",
        # Boost libraries for sonic_data_client CGO
        "libboost-thread-dev",
        "libboost-system-dev",
        # Python 3.11 for sonic_data_client
        "libpython3.11-dev",
    ],
    suites = [
        "bookworm",
        "bookworm-updates",
        "bookworm-security",
    ],
)
apt.lock(into = ":packages.lock")
use_repo(apt, "bookworm")

# TODO(bazel-ready): replace with new version of rules_m4 when this merges:
#  https://github.com/jmillikin/rules_m4/pull/23
git_override(
    module_name = "rules_m4",
    commit = "54e35332761523b8b8c7e7a17c8fd3733e53e3e7",
    remote = "https://github.com/blorente/rules_m4",
)

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.0")

# Go dependencies via gazelle's go_deps extension
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Bazel-only deps: not transitive Go deps of sonic-gnmi, so they don't appear in go.mod
# (because of module pruning).
#
# However, Bazel fetches entire repos and their BUILD files reference these packages.
# go_deps.module() makes them available without polluting go.mod.
go_deps.module(
    path = "golang.org/x/term", # needed by x/crypto
    sum = "h1:WP60Sv1nlK1T6SupCHbXzSaN0b9wUmsPoRS9b61A23Q=",
    version = "v0.27.0",
)

# Export all Go dependencies
# Note: This list must _not_ be updated manually with `bazel mod tidy`.
# we have intentionally excluded some repositories that do appear in go.mod,
# because we need to patch them in the build.
#
# Running `bazel mod tidy` adds the to this list, whereas
# we instead want to load them from `sonic_go_repos`.
use_repo(
    go_deps,
    "com_github_agiledragon_gomonkey_v2",
    "com_github_c9s_goprocinfo",
    "com_github_dgrijalva_jwt_go",
    "com_github_fsnotify_fsnotify",
    "com_github_godbus_dbus_v5",
    "com_github_gogo_protobuf",
    "com_github_golang_protobuf",
    "com_github_google_go_tpm",
    "com_github_google_gofuzz",
    "com_github_grpc_ecosystem_go_grpc_middleware_v2",
    "com_github_hashicorp_golang_lru",
    "com_github_kylelemons_godebug",
    "com_github_nxadm_tail",
    "com_github_pkg_errors",
    "com_github_redis_go_redis_v9",
    "com_github_workiva_go_datastructures",
    "com_github_xeipuuv_gojsonschema",
    "in_gopkg_yaml_v2",
    "org_golang_google_genproto_googleapis_rpc",
    "org_golang_google_grpc", # Note that this is different from `com_github_grpc_grpc`.
    "org_golang_google_grpc_security_advancedtls",
    "org_golang_google_protobuf",
    "org_golang_x_crypto",
    "org_golang_x_net",
)

# Inject repos into go_deps extension to make them visible to its repos
# This solves cross-repo visibility issues (https://github.com/bazelbuild/bazel/issues/19301)
# inject_repo makes the specified repos available to repos created by go_deps
inject_repo(go_deps, "com_github_grpc_grpc")  # For openconfig/gnmi's cc_grpc_library.bzl

inject_repo(go_deps, "rules_proto_grpc")  # For openconfig/gnsi's proto rules

inject_repo(go_deps, "rules_proto_grpc_cpp")  # For openconfig/gnsi's cpp_grpc_library

inject_repo(go_deps, "rules_java")  # For envoyproxy/protoc-gen-validate

inject_repo(go_deps, "bookworm")  # For msteinert/pam's libpam0g dependency

# SONiC-patched ygot/goyang/gnmi from sonic-mgmt-common's extension. The extension is not
# root-only, so consumers of sonic-gnmi get these repos without any extra boilerplate.
sonic_go_repos = use_extension("@sonic-mgmt-common//:go_repos.bzl", "sonic_go_repos")
use_repo(
    sonic_go_repos,
    "com_github_golang_glog",
    "com_github_google_gnxi",
    "com_github_google_gousb",
    "com_github_mitchellh_go_wordwrap",
    "com_github_msteinert_pam",
    "com_github_openconfig_gnmi",
    "com_github_openconfig_gnoi",
    "com_github_openconfig_gnsi",
    "com_github_openconfig_goyang",
    "com_github_openconfig_grpctunnel",
    "com_github_openconfig_ygot",
    "com_github_protocolbuffers_txtpbfmt",
)
