    "org_golang_google_protobuf",
    "org_golang_x_crypto",
    "org_golang_x_net",
    "org_golang_x_tools",  # For nogo static analysis

    # TODO BL: Imported, but not in deps
    # "com_github_mitchellh_go_wordwrap",  # For txtpbfmt
    # "com_github_protocolbuffers_txtpbfmt",  # For openconfig/gnmi cli
    # "org_golang_x_term",  # For crypto/ssh
)

# SONiC-patched ygot/goyang/gnmi from sonic-mgmt-common's extension. The extension is not
# root-only, so consumers of sonic-gnmi get these repos without any extra boilerplate.
sonic_go_repos = use_extension("@sonic-mgmt-common//:go_repos.bzl", "sonic_go_repos")
use_repo(
    sonic_go_repos,
    "com_github_openconfig_gnmi",
    "com_github_openconfig_goyang",
    "com_github_openconfig_ygot",
)

inject_repo(sonic_go_repos, "rules_proto")

inject_repo(sonic_go_repos, "org_golang_google_protobuf")
