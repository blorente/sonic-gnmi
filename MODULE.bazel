module(
    name = "sonic-gnmi",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_go", version = "0.60.0", repo_name = "io_bazel_rules_go")
local_path_override(
    module_name = "rules_go",
    path = "../rules_go",
)
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "gazelle", version = "0.46.0")
bazel_dep(name = "protobuf", version = "23.1", repo_name = "com_google_protobuf")
bazel_dep(name = "grpc", version = "1.56.3.bcr.1", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_proto_grpc", version = "5.0.0")
bazel_dep(name = "rules_proto_grpc_cpp", version = "5.0.0")
bazel_dep(name = "package_metadata", version = "0.0.6")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "rules_java", version = "8.14.0")
bazel_dep(name = "googleapis", version = "0.0.0-20251104-53af3b72")
bazel_dep(name = "googleapis-go", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "sonic-swss-common", version = "0.0.0")
local_path_override(
    module_name = "sonic-swss-common",
    path = "../sonic-swss-common",
)

bazel_dep(name = "sonic-mgmt-common", version = "1.0.0")
local_path_override(
    module_name = "sonic-mgmt-common",
    path = "../sonic-mgmt-common",
)

bazel_dep(name = "libnl3", version = "3.7.0")
local_path_override(
    module_name = "libnl3",
    path = "../sonic-buildimage/src/libnl3",
)

bazel_dep(name = "rules_distroless", version = "0.0.0")
local_path_override(
    module_name = "rules_distroless",
    path = "../rules_distroless",
)

bazel_dep(name = "sonic-build-infra", version = "0.0.0")
local_path_override(
    module_name = "sonic-build-infra",
    path = "../sonic-build-infra",
)
register_toolchains("@sonic-build-infra//toolchains/gcc:host_gcc_toolchain")

bazel_dep(name = "libyang", version = "1.0.73", repo_name = "com_github_cesnet_libyang")
local_path_override(
    module_name = "libyang",
    path = "../sonic-buildimage/src/libyang",
)

# APT packages from Debian bookworm
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = [
        "bookworm",
        "bookworm-updates",
    ],
    uris = ["https://snapshot.debian.org/archive/debian/20251001T023456Z"],
)
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["bookworm-security"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20251001T023456Z"],
)
apt.install(
    dependency_set = "bookworm",
    packages = [
        # sonic-gnmi specific packages
        "libpam0g",
        "libpam0g-dev",
        "libpcre3",
        "libpcre3-dev",
        "libusb-1.0-0",
        "libusb-1.0-0-dev",
        # libudev is needed by libusb
        "libudev1",
        "libudev-dev",
        # Boost libraries (thread and system for sonic-gnmi, base + serialization for sonic-swss-common)
        "libboost-dev",
        "libboost-serialization-dev",
        "libboost-thread-dev",
        "libboost-system-dev",
        # Python 3.11 for sonic_data_client
        "libpython3.11-dev",
        "python3.11-dev",
        # crypt.h needed by Python headers
        "libcrypt-dev",
    ],
    suites = ["bookworm"],
)
apt.lock(into = ":packages.lock")
use_repo(apt, "bookworm")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.5")

# Go dependencies via gazelle's go_deps extension
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# protocolbuffers/txtpbfmt - needed by openconfig/gnmi cli
go_deps.module(
    path = "github.com/protocolbuffers/txtpbfmt",
    sum = "h1:AKJY61V2SQtJ2a2PdeswKk0NM1qF77X+julRNYRxPOk=",
    version = "v0.0.0-20220608084003-fc78c767cd6a",
)

# golang.org/x/term - needed by crypto/ssh
go_deps.module(
    path = "golang.org/x/term",
    sum = "h1:WP60Sv1nlK1T6SupCHbXzSaN0b9wUmsPoRS9b61A23Q=",
    version = "v0.27.0",
)

# mitchellh/go-wordwrap - needed by txtpbfmt
go_deps.module(
    path = "github.com/mitchellh/go-wordwrap",
    sum = "h1:TLuKupo69TCn6TQSyGxwI1EblZZEsQ0vMlAFQflz0v0=",
    version = "v1.0.1",
)

# Export all Go dependencies
# Note: Run 'bazel mod tidy' to automatically update this list
use_repo(
    go_deps,
    "com_github_agiledragon_gomonkey_v2",
    "com_github_c9s_goprocinfo",
    "com_github_dgrijalva_jwt_go",
    "com_github_fsnotify_fsnotify",
    "com_github_godbus_dbus_v5",
    "com_github_gogo_protobuf",
    "com_github_golang_glog",
    "com_github_golang_protobuf",
    "com_github_google_gnxi",
    "com_github_google_go_tpm",
    "com_github_google_gofuzz",
    "com_github_google_gousb",  # uses system libusb from apt
    "com_github_grpc_ecosystem_go_grpc_middleware_v2",
    "com_github_hashicorp_golang_lru",
    "com_github_kylelemons_godebug",
    "com_github_mitchellh_go_wordwrap",  # For txtpbfmt
    "com_github_msteinert_pam",
    "com_github_nxadm_tail",
    "com_github_openconfig_gnmi",
    "com_github_openconfig_gnoi",
    "com_github_openconfig_gnsi",
    "com_github_pkg_errors",
    "com_github_protocolbuffers_txtpbfmt",  # For openconfig/gnmi cli
    "com_github_redis_go_redis_v9",
    "com_github_workiva_go_datastructures",
    "com_github_xeipuuv_gojsonschema",
    "in_gopkg_yaml_v2",
    "org_golang_google_genproto_googleapis_rpc",
    "org_golang_google_grpc",
    "org_golang_google_grpc_security_advancedtls",  # separate grpc module for advancedtls
    "org_golang_google_protobuf",
    "org_golang_x_crypto",
    "org_golang_x_net",
    "org_golang_x_term",  # For crypto/ssh
    "org_golang_x_tools",  # For nogo static analysis
)

# Inject repos into go_deps extension to make them visible to its repos
# This solves cross-repo visibility issues (https://github.com/bazelbuild/bazel/issues/19301)
# inject_repo makes the specified repos available to repos created by go_deps
inject_repo(go_deps, "com_github_grpc_grpc")  # For openconfig/gnmi's cc_grpc_library.bzl

inject_repo(go_deps, "rules_proto_grpc_cpp")  # For openconfig/gnsi's cpp_grpc_library

inject_repo(go_deps, "rules_java")  # For envoyproxy/protoc-gen-validate

inject_repo(go_deps, "bookworm")  # For msteinert/pam's libpam0g dependency

# openconfig/gnoi and gnsi ship WORKSPACE-style BUILD files with old repo names.
# Regenerate them clean so gazelle uses bzlmod-canonical names.
go_deps.gazelle_override(
    build_file_generation = "off",
    path = "github.com/openconfig/gnoi",
)
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable_global"],
    path = "github.com/openconfig/gnsi",
)

# gousb needs a hand-written BUILD file with CDeps for libusb and libudev from @bookworm
go_deps.module_override(
    patches = ["//patches:gousb_build.patch"],
    path = "github.com/google/gousb",
)
go_deps.gazelle_override(
    build_file_generation = "off",
    path = "github.com/google/gousb",
)


# SONiC-patched ygot/goyang from sonic-mgmt-common's extension. The extension is not
# root-only, so consumers of sonic-gnmi get these repos without any extra boilerplate.
sonic_go_repos = use_extension("@sonic-mgmt-common//:go_repos.bzl", "sonic_go_repos")
use_repo(sonic_go_repos, "com_github_openconfig_ygot", "com_github_openconfig_goyang")
inject_repo(sonic_go_repos, "rules_proto")
inject_repo(sonic_go_repos, "org_golang_google_protobuf")
inject_repo(sonic_go_repos, "com_google_protobuf")

# msteinert/pam needs a hand-written BUILD file with CGO CDeps pointing to @bookworm apt packages
go_deps.module_override(
    patches = ["//patches:msteinert_pam.patch"],
    path = "github.com/msteinert/pam",
)
go_deps.gazelle_override(
    build_file_generation = "off",
    path = "github.com/msteinert/pam",
)

bazel_dep(name = "rules_python", version = "1.6.3")

# Pin rules_python to 1.6.3 for stability. With protoc-gen-validate@1.3.0 pinned above,
# newer versions of rules_python may now be compatible - this can be tested later.
single_version_override(
    module_name = "rules_python",
    version = "1.6.3",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.11",
)
