module(
    name = "gnmi",
    version = "0.0.0",
)

# Hermetic C/C++ toolchain for reproducible builds
bazel_dep(name = "hermetic_cc_toolchain", version = "3.1.0")

# Rules for building foreign (non-Bazel) projects like CMake
bazel_dep(name = "rules_foreign_cc", version = "0.12.0")

# Platform rules for target configuration
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_go", version = "0.50.1")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "gazelle", version = "0.46.0")
bazel_dep(name = "protobuf", version = "33.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "googleapis", version = "0.0.0-20251104-53af3b72")
bazel_dep(name = "googleapis-go", version = "1.0.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.21.5")

legacy = use_extension("//:deps.bzl", "deps")
use_repo(
    legacy,
    "com_github_antchfx_jsonquery",
    "com_github_antchfx_xmlquery",
    "com_github_antchfx_xpath",
    "com_github_c9s_goprocinfo",
    "com_github_dgrijalva_jwt_go",
    "com_github_godbus_dbus_v5",
    "com_github_gogo_protobuf",
    "com_github_golang_glog",
    "com_github_golang_groupcache",
    "com_github_golang_protobuf",
    "com_github_google_go_cmp",
    "com_github_google_go_tpm",
    "com_github_grpc_ecosystem_go_grpc_middleware_v2",
    "com_github_hashicorp_golang_lru",
    "com_github_kylelemons_godebug",
    "com_github_maruel_natural",
    "com_github_nxadm_tail",
    "com_github_openconfig_gnmi",
    "com_github_openconfig_gnoi",
    "com_github_openconfig_gnsi",
    "com_github_openconfig_goyang",
    "com_github_openconfig_ygot",
    "com_github_philopon_go_toposort",
    "com_github_pkg_errors",
    "com_github_redis_go_redis_v9",
    "com_github_tredoe_osutil",
    "com_github_workiva_go_datastructures",
    "in_gopkg_yaml_v2",
    "org_golang_google_genproto_googleapis_rpc",
    "org_golang_google_grpc",
    "org_golang_google_grpc_security_advancedtls",
    "org_golang_google_protobuf",
    "org_golang_x_crypto",
    "org_golang_x_net",
    "org_golang_x_text",
)

bazel_dep(name = "rules_python", version = "1.6.3")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.9",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.9",
    requirements_lock = "//third_party/pip:requirements.txt",
)
use_repo(pip, "pip")

# HTTP archive for fetching libyang
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# Register the hermetic toolchain
register_toolchains("@hermetic_cc_toolchain//toolchain:all")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "pcre_archive",
    build_file = "//third_party/pcre:BUILD.bazel",
    sha256 = "4dae6fdcd2bb0bb6c37b5f97c33c2be954da743985369cddac3546e3218bffb8",
    urls = [
        "https://sourceforge.net/projects/pcre/files/pcre/8.45/pcre-8.45.tar.bz2",
    ],
)

http_archive(
    name = "com_github_cesnet_libyang",
    build_file = "//third_party/libyang:BUILD.bazel",
    patch_args = ["-p1"],
    patches = [
        #"//patches:libyang-repo.patch",
        "//patches:libyang.patch",
    ],
    sha256 = "1b736443d2c69b5d7a71ac412655e6edab0647b18f35f7bf504b0a24e06cb046",
    strip_prefix = "libyang-1.0.225",
    urls = [
        "https://github.com/CESNET/libyang/archive/refs/tags/v1.0.225.tar.gz",
    ],
)

http_archive(
    name = "libusb",
    build_file = "//third_party/libusb:BUILD.bazel",
