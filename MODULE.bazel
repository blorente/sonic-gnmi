module(
    name = "gnmi",
    version = "0.0.0",
)

# Hermetic C/C++ toolchain for reproducible builds
bazel_dep(name = "hermetic_cc_toolchain", version = "3.1.0")

# Rules for building foreign (non-Bazel) projects like CMake
bazel_dep(name = "rules_foreign_cc", version = "0.12.0")

# Platform rules for target configuration
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_go", version = "0.50.1", repo_name = "io_bazel_rules_go")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "gazelle", version = "0.46.0")
bazel_dep(name = "protobuf", version = "23.1", repo_name = "com_google_protobuf")
bazel_dep(name = "grpc", version = "1.56.3.bcr.1", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_proto_grpc", version = "5.0.0")
bazel_dep(name = "rules_proto_grpc_cpp", version = "5.0.0")
bazel_dep(name = "package_metadata", version = "0.0.6")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "rules_java", version = "8.10.0")
bazel_dep(name = "googleapis", version = "0.0.0-20251104-53af3b72")
bazel_dep(name = "googleapis-go", version = "1.0.0")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.22.4")

# Go dependencies via gazelle's go_deps extension
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Module overrides for repositories requiring patches or special build settings

# gousb - use archive_override with custom BUILD that links libusb
# We use inject_repo to make @libusb visible to go_deps
go_deps.archive_override(
    patch_strip = 1,
    patches = ["//patches:gousb_build.patch"],
    path = "github.com/google/gousb",
    sha256 = "c50544ad2bd81a431ff26f3df6cfdd93042e8a70effc808c63a43a0a8c07ea68",
    strip_prefix = "gousb-1.1.3",
    urls = [
        "https://github.com/google/gousb/archive/refs/tags/v1.1.3.tar.gz",
    ],
)
go_deps.gazelle_override(
    build_file_generation = "off",
    path = "github.com/google/gousb",
)

# antchfx packages need patches
go_deps.module_override(
    patch_strip = 1,
    patches = ["//patches:jsonquery.patch"],
    path = "github.com/antchfx/jsonquery",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//patches:xmlquery.patch"],
    path = "github.com/antchfx/xmlquery",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//patches:xpath.patch"],
    path = "github.com/antchfx/xpath",
)

# gogo/protobuf - disable proto file generation
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable",
    ],
    path = "github.com/gogo/protobuf",
)

# golang/glog - needs patch and version replacement (handled via go.mod replace)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//patches:glog.patch"],
    path = "github.com/golang/glog",
)

# google/gnxi - needs patch
go_deps.module_override(
    patch_strip = 1,
    patches = ["//patches:github.com-google-gnxi.patch"],
    path = "github.com/google/gnxi",
)

# msteinert/pam - in deps.bzl due to dependency on @//:third_party_pam from main repo
# This cannot be moved to go_deps because inject_repo cannot inject the root module

# openconfig/gnmi - disable proto, needs patch
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable",
    ],
    path = "github.com/openconfig/gnmi",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//patches:github.com-openconfig-gnmi.patch"],
    path = "github.com/openconfig/gnmi",
)

# openconfig/gnsi is in deps.bzl due to cross-repo dependency on @rules_proto_grpc

# openconfig/goyang - needs patch
go_deps.module_override(
    patch_strip = 1,
    patches = ["//patches/goyang:goyang.patch"],
    path = "github.com/openconfig/goyang",
)

# openconfig/grpctunnel - disable proto, custom gazelle directives
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable",
        "gazelle:proto_import_prefix github.com/openconfig/grpctunnel",
        "gazelle:prefix github.com/openconfig/grpctunnel",
        "gazelle:resolve go github.com/openconfig/grpctunnel/proto/tunnel //proto/tunnel:go_default_library",
    ],
    path = "github.com/openconfig/grpctunnel",
)

# openconfig/ygot - needs patches and gazelle directives
go_deps.gazelle_override(
    directives = [
        "gazelle:proto_import_prefix github.com/openconfig/ygot",
    ],
    path = "github.com/openconfig/ygot",
)
go_deps.module_override(
    patch_strip = 1,
    patches = [
        "//patches:github.com-openconfig-ygot.patch",
        "//patches/ygot:ygot.patch",
    ],
    path = "github.com/openconfig/ygot",
)

# google.golang.org/grpc - disable proto
# Note: grpc_advancedtls.patch removed - newer grpc versions have different structure
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable",
    ],
    path = "google.golang.org/grpc",
)

# google.golang.org/protobuf - disable global proto mode
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable",
    ],
    path = "google.golang.org/protobuf",
)

# envoyproxy/protoc-gen-validate - custom naming convention
go_deps.gazelle_override(
    directives = [
        "gazelle:go_naming_convention import_alias",
    ],
    path = "github.com/envoyproxy/protoc-gen-validate",
)

# Export all Go dependencies
# Note: Run 'bazel mod tidy' to automatically update this list
use_repo(
    go_deps,
    "com_github_agiledragon_gomonkey_v2",
    "com_github_antchfx_jsonquery",
    "com_github_antchfx_xmlquery",
    "com_github_antchfx_xpath",
    # sonic-mgmt-common is vendored locally in cvl/ and translib/ directories
    "com_github_c9s_goprocinfo",
    "com_github_cenkalti_backoff_v4",
    "com_github_cespare_xxhash_v2",
    "com_github_cncf_xds_go",
    "com_github_dgrijalva_jwt_go",
    "com_github_dgryski_go_rendezvous",
    "com_github_envoyproxy_go_control_plane",
    "com_github_envoyproxy_protoc_gen_validate",
    "com_github_fsnotify_fsnotify",
    "com_github_godbus_dbus_v5",
    "com_github_gogo_protobuf",
    "com_github_golang_glog",
    "com_github_golang_groupcache",
    "com_github_golang_protobuf",
    "com_github_google_gnxi",
    "com_github_google_go_cmp",
    "com_github_google_go_tpm",
    "com_github_google_gofuzz",
    "com_github_google_gousb",  # via archive_override with custom BUILD linking libusb
    "com_github_grpc_ecosystem_go_grpc_middleware_v2",
    "com_github_hashicorp_golang_lru",
    "com_github_kylelemons_godebug",
    "com_github_maruel_natural",
    # msteinert/pam is in deps.bzl - needs @//:third_party_pam from main repo
    "com_github_nxadm_tail",
    "com_github_openconfig_gnmi",
    # gnoi is in deps.bzl due to cross-repo dependency on @com_github_grpc_grpc
    # gnsi is in deps.bzl due to cross-repo dependency on @rules_proto_grpc
    "com_github_openconfig_goyang",
    "com_github_openconfig_grpctunnel",
    "com_github_openconfig_ygot",
    "com_github_philopon_go_toposort",
    "com_github_pkg_errors",
    "com_github_redis_go_redis_v9",
    "com_github_stretchr_testify",
    "com_github_tredoe_osutil",
    "com_github_workiva_go_datastructures",
    "com_github_xeipuuv_gojsonpointer",
    "com_github_xeipuuv_gojsonreference",
    "com_github_xeipuuv_gojsonschema",
    "in_gopkg_tomb_v1",
    "in_gopkg_yaml_v2",
    "org_golang_google_genproto_googleapis_api",
    "org_golang_google_genproto_googleapis_rpc",
    "org_golang_google_grpc",
    "org_golang_google_grpc_security_advancedtls",  # separate grpc module for advancedtls
    "org_golang_google_protobuf",
    "org_golang_x_crypto",
    "org_golang_x_net",
    "org_golang_x_sys",
    "org_golang_x_text",
)

# Inject repos into go_deps extension to make them visible to its repos
# This solves cross-repo visibility issues (https://github.com/bazelbuild/bazel/issues/19301)
# inject_repo makes the specified repos available to repos created by go_deps
inject_repo(go_deps, "libusb")  # For gousb's cdeps = ["@libusb//:libusb"]

inject_repo(go_deps, "com_github_grpc_grpc")  # For openconfig/gnmi's cc_grpc_library.bzl

inject_repo(go_deps, "rules_proto_grpc_cpp")  # For openconfig/gnsi's cpp_grpc_library

inject_repo(go_deps, "rules_java")  # For envoyproxy/protoc-gen-validate

bazel_dep(name = "rules_python", version = "1.6.3")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.9",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.9",
    requirements_lock = "//third_party/pip:requirements_lock.txt",
)
use_repo(pip, "pip")

# Legacy Go dependencies that cannot use go_deps due to cross-repo visibility issues
# See: https://github.com/bazelbuild/bazel/issues/19301
legacy = use_extension("//:deps.bzl", "deps")
use_repo(
    legacy,
    # grpc/grpc is now via bazel_dep with repo_name = "com_github_grpc_grpc"
    "com_github_msteinert_pam",
    "com_github_openconfig_gnoi",
    "com_github_openconfig_gnsi",
)

# HTTP archive for fetching libyang
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# Register the hermetic toolchain
register_toolchains("@hermetic_cc_toolchain//toolchain:all")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "pcre_archive",
    build_file = "//third_party/pcre:BUILD.bazel",
    sha256 = "4dae6fdcd2bb0bb6c37b5f97c33c2be954da743985369cddac3546e3218bffb8",
    urls = [
        "https://sourceforge.net/projects/pcre/files/pcre/8.45/pcre-8.45.tar.bz2",
    ],
)

http_archive(
    name = "com_github_cesnet_libyang",
    build_file = "//third_party/libyang:BUILD.bazel",
    patch_args = ["-p1"],
    patches = [
        #"//patches:libyang-repo.patch",
        "//patches:libyang.patch",
        "//patches:libyang_pcre_cache.patch",
    ],
    sha256 = "1b736443d2c69b5d7a71ac412655e6edab0647b18f35f7bf504b0a24e06cb046",
    strip_prefix = "libyang-1.0.225",
    urls = [
        "https://github.com/CESNET/libyang/archive/refs/tags/v1.0.225.tar.gz",
    ],
)

http_archive(
    name = "libusb",
    build_file = "//third_party/libusb:BUILD.bazel",
    sha256 = "ffaa41d741a8a3bee244ac8e54a72ea05bf2879663c098c82fc5757853441575",
    strip_prefix = "libusb-1.0.27",
    urls = [
        "https://github.com/libusb/libusb/releases/download/v1.0.27/libusb-1.0.27.tar.bz2",
    ],
)

http_archive(
    name = "linux_pam",
    build_file = "//third_party/pam:linux_pam.BUILD",
    patch_args = ["-p1"],
    patches = ["//patches:linux_pam_opasswd.patch"],
    sha256 = "7ac4b50feee004a9fa88f1dfd2d2fa738a82896763050cd773b3c54b0a818283",
    strip_prefix = "Linux-PAM-1.5.3",
    urls = [
        "https://github.com/linux-pam/linux-pam/releases/download/v1.5.3/Linux-PAM-1.5.3.tar.xz",
    ],
)

# msteinert/pam Go wrapper now uses go_repository from deps.bzl with custom BUILD
# The PAM C library is built hermetically below

git_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:git.bzl",
    "git_repository",
)

git_repository(
    name = "sonic-swss-common",
    build_file = "//third_party/sonic_swss_common:BUILD.bazel",
    commit = "7a25b0754f8f29d179c45fd3df48ceb96d2bc849",
    remote = "https://github.com/sonic-net/sonic-swss-common",
)

git_repository(
    name = "sonic-buildimage",
    branch = "master",
    build_file = "//third_party/sonic_build_image:BUILD.bazel",
    remote = "https://github.com/sonic-net/sonic-buildimage",
)

git_repository(
    name = "com_github_nlohmann_json",
    # Current tip of "develop" branch as of Nov-2023.  Using this commit since
    # the last release is quite old and does not contain bazel support.
    commit = "6eab7a2b187b10b2494e39c1961750bfd1bda500",
    remote = "https://github.com/nlohmann/json",
)
