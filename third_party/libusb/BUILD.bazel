load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
)

configure_make(
    name = "libusb",
    configure_in_place = True,
    configure_options = [
        "--disable-shared",
        "--enable-static",
        "--disable-udev",
    ],
    lib_source = ":all_srcs",
    out_static_libs = ["libusb-1.0.a"],
    visibility = ["//visibility:public"],
)
