load("@rules_pkg//:pkg.bzl", "pkg_tar")

# Export docker-related files for use in container images
exports_files(
    glob(
        [
            "dockers/docker-base-bullseye/etc/**/*",
            "dockers/docker-sonic-gnmi/**/*",
            "src/sonic-supervisord-utilities/scripts/*",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "exported_yangs",
    srcs = glob(["src/sonic-yang-models/yang-models/*.yang"], allow_empty = True),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "exported_yang_templates",
    srcs = glob(["src/sonic-yang-models/yang-templates/*.yang.j2"], allow_empty = True),
    visibility = ["//visibility:public"],
)

genrule(
    name = "yang-file-export",
    srcs = [],
    outs = [
        "sonic-yangs-export.tar",
        "sonic-yang-templates-export.tar",
    ],
    cmd = "touch $(OUTS)",
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "sonic-cfggen",
    srcs = glob(["src/sonic-config-engine/*"], allow_empty = True),
    mode = "0644",
    package_dir = "/sonic-config-engine",
    # strip_prefix = "/testdata",
    visibility = ["//visibility:public"],
)
