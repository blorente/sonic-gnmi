load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

filegroup(
    name = "all_srcs",
    srcs = glob(
        include = ["**"],
        exclude = ["*.bazel"],
    ),
)

configure_make(
    name = "pam",
    configure_options = [
        "--disable-db",
        "--disable-selinux",
        "--disable-nls",
        "--disable-regenerate-docu",
        "--disable-doc",
        "--enable-static",
        "--disable-shared",
    ],
    lib_source = "@linux_pam//:all",
    out_include_dir = "include",
    out_static_libs = ["libpam.a"],
    # Post-install step to move headers to security/ subdirectory for CGo to find them
    postfix_script = """
        mkdir -p $INSTALLDIR/include/security
        mv $INSTALLDIR/include/*.h $INSTALLDIR/include/security/ 2>/dev/null || true
    """,
    # Only build and install libpam (library + headers), not the modules (which require libcrypt)
    targets = [
        "-C libpam install",
    ],
    visibility = ["//visibility:public"],
)
