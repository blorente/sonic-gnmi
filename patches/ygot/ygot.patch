+// getLeafTimestamp returns leaf's specific timestamp if found in metadata, 0 otherwise.
+func getLeafTimestamp(m *YGStructMeta, leaf interface{}) int64 {
+        if m == nil {
+                return 0
+        }
+
+        ts := m.TimestampNano
+        if m.LeafMeta != nil && len(m.LeafMeta) > 0 {
+                if lm, ok := m.LeafMeta[leaf]; ok {
+                        ts = lm.TimestampNano
+                }
+        }
+
+        if ts > 0 {
+                return ts
+        }
+        return 0
+}
