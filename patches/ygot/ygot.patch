+// TogNMINotificationsWithMeta extends ygot.TogNMINotifications to render
+// notifications using meta information stored in metaMap.
+// For example, ygot.TogNMINotifications returns only one notification,
+// TogNMINotificationsWithMeta may split the notification to multiple
+// notifications (with different timestamps) if there are node specific
+// TimestampNano in metaMap.
+func TogNMINotificationsWithMeta(s GoStruct, defaultTs int64, cfg GNMINotificationsConfig, metaMap YGStructMetaMap) ([]*gnmipb.Notification, error) {
+
+        if metaMap == nil || len(metaMap) == 0 {
+                return TogNMINotifications(s, defaultTs, cfg)
+        }
+
+        var pfx *gnmiPath
+        if cfg.UsePathElem {
+                pfx = newPathElemGNMIPath(cfg.PathElemPrefix)
+        } else {
+                pfx = newStringSliceGNMIPath(cfg.StringSlicePrefix)
+        }
+
+        // Assume metaMap is small. We can initialize the tsLeaves map to improve performance.
+        tsLeaves := map[int64]map[*path]interface{}{0: make(map[*path]interface{})}
+        for _, m := range metaMap {
+                if _, ok := tsLeaves[m.TimestampNano]; !ok {
+                        tsLeaves[m.TimestampNano] = make(map[*path]interface{})
+                }
+        }
+
+        // Traverse s and collect all updated leaf nodes into tsLeaves. The updated leaves
+        // are grouped by their timestamps.
+        if err := findUpdatedLeavesWithMeta(tsLeaves, s, pfx, metaMap); err != nil {
+                return nil, err
+        }
+
+        notifications := []*gnmipb.Notification{}
+        for ts, leaves := range tsLeaves {
+                if len(leaves) == 0 {
+                        continue
+                }
+                if ts == 0 {
+                        ts = defaultTs
+                }
+                msgs, err := leavesToNotifications(leaves, ts, pfx, cfg.Encoding)
+                if err != nil {
+                        return nil, err
+                }
+                notifications = append(notifications, msgs...)
+        }
+
+        return notifications, nil
+}
+
+// findUpdatedLeavesWith appends the valid leaves that are within the supplied
+// GoStruct (assumed to the rooted at parentPath) to the supplied tsLeaves map.
+// tsLeaves are grouped by the leaves' timestamps (in supplied YGStructMetaMap).
+// If errors are encountered they are appended to the errlist.List supplied. If
+// the GoStruct contains fields that are themselves structured objects (YANG
+// lists, or containers - represented as maps or struct pointers), the function
+// is called recursively on them.
+func findUpdatedLeavesWithMeta(tsLeaves map[int64]map[*path]interface{}, s GoStruct, parent *gnmiPath, metaMap YGStructMetaMap) error {
+        var errs errlist.List
+
+        if !parent.isValid() {
+                return fmt.Errorf("invalid parent specified: %v", parent)
+        }
+
+        sval := reflect.ValueOf(s)
+        if s == nil || util.IsValueNil(sval) || !sval.IsValid() || !util.IsValueStructPtr(sval) {
+                errs.Add(fmt.Errorf("input struct for %v was not valid", parent))
+                return errs.Err()
+        }
+        sval = sval.Elem()
+
+        stype := sval.Type()
+
+        for i := 0; i < sval.NumField(); i++ {
+                fval := sval.Field(i)
+                ftype := stype.Field(i)
+
+                // Handle nil values, and enumerations specifically.
+                switch fval.Kind() {
+                case reflect.Map, reflect.Slice, reflect.Ptr, reflect.Interface:
+                        if fval.IsNil() {
+                                continue
+                        }
